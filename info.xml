<?xml version="1.0"?>
<extension key="au.com.agileware.mailapprovers" type="module">
  <file>mailapprovers</file>
  <name>Mail Approvers per Email</name>
  <description>Allows specifiying one or more ACL Groups that can approve Mailings for each "From Email" address.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Agileware</author>
    <email>projects@agileware.com.au</email>
  </maintainer>
  <urls>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-09-12</releaseDate>
  <version>1.0.2</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <civix>
    <namespace>CRM/Mailapprovers</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
</extension>
